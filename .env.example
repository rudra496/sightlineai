# SightlineAI — Environment Configuration Template
# Copy this file to .env and fill in your values.
# Never commit your real .env to version control.

# ── Required ───────────────────────────────────────────────────────────────────
# Your DashScope API key (Alibaba Cloud Model Studio)
# Get one at: https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# ── Optional ───────────────────────────────────────────────────────────────────
# Override the DashScope-compatible base URL (default shown below)
# DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Qwen model name (default shown below)
# QWEN_MODEL=qwen3.7-max

# Request timeout in seconds (default: 25)
# QWEN_TIMEOUT_SECONDS=25
