AI_PROVIDER=auto

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=25

DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-max
QWEN_TIMEOUT_SECONDS=25

APP_NAME=SightlineAI
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

DATABASE_URL=sqlite:///./sightline.db
REDIS_URL=redis://localhost:6379

MAX_IMAGE_BYTES=5242880
MAX_IMAGE_SIZE_MB=5

OFFLINE_MODE=false
CACHE_RESPONSES=true

DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,bn,ar,es

WEBSOCKET_HEARTBEAT=30

CORS_ORIGINS=*

OSM_ENDPOINT=https://overpass-api.de/api

ENABLE_LIDAR=false
ENABLE_IMU=false

ENABLE_ANALYTICS=false
ENABLE_ERROR_REPORTING=false# ==========================================================
SECRET_KEY=change_this_to_a_secure_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==========================================================
# DATABASE
# ==========================================================
DATABASE_URL=sqlite:///./sightline.db

# PostgreSQL Example:
# DATABASE_URL=postgresql://user:password@localhost/sightlineai

# ==========================================================
# REDIS
# ==========================================================
REDIS_URL=redis://localhost:6379

# ==========================================================
# IMAGE PROCESSING
# ==========================================================
MAX_IMAGE_BYTES=5242880
MAX_IMAGE_SIZE_MB=5

# ==========================================================
# OFFLINE FALLBACK
# ==========================================================
OFFLINE_MODE=false
CACHE_RESPONSES=true

# ==========================================================
# LANGUAGE SETTINGS
# ==========================================================
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,bn,ar,es

# ==========================================================
# WEBSOCKET
# ==========================================================
WEBSOCKET_HEARTBEAT=30

# ==========================================================
# CORS
# ==========================================================
CORS_ORIGINS=*

# ==========================================================
# MAPS & NAVIGATION
# ==========================================================
OSM_ENDPOINT=https://overpass-api.de/api

# ==========================================================
# OPTIONAL HARDWARE SETTINGS
# ==========================================================
ENABLE_LIDAR=false
ENABLE_IMU=false

# ==========================================================
# TELEMETRY
# ==========================================================
ENABLE_ANALYTICS=false
ENABLE_ERROR_REPORTING=false
